{
	"schemaVersion": 1,
	"id": "mob-cap-display",
	"version": "${version}",
	"name": "Mob Cap Display",
	"description": "Shows which mob types fill each mob cap category, with per-type counts for the global and local caps.",
	"authors": [
		"lukeeIRL"
	],
	"contact": {
		"homepage": "https://github.com/mcdougallluke/Mob-Cap-Display",
		"sources": "https://github.com/mcdougallluke/Mob-Cap-Display",
		"issues": "https://github.com/mcdougallluke/Mob-Cap-Display/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/mob-cap-display/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "dev.lukemcd.mobcapdisplay.MobCapDisplay",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "dev.lukemcd.mobcapdisplay.client.MobCapDisplayClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"mob-cap-display.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.160.6",
		"fabric-language-kotlin": ">=1.13.12+kotlin.2.4.0"
	}
}